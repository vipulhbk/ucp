# ---- Persistence -------------------------------------------------------------------------------
# Production on Vercel MUST use Redis (serverless instances do not share memory).
# Provided by the Upstash Redis integration (Vercel Marketplace). Either naming is accepted.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# STORE_DRIVER=memory            # force in-memory for local development
# ALLOW_MEMORY_STORE=true        # only for a throwaway Vercel preview; data is lost between invocations

# ---- Identity of this deployment ----------------------------------------------------------------
# Canonical public origin. If unset: PUBLIC_BASE_URL -> VERCEL_URL -> request origin (local dev only).
PUBLIC_BASE_URL=
# Reverse-domain namespace for the demo's custom payment handler, e.g. com.yourdomain  -> com.yourdomain.mock_tokenizer
# Set this only when schemas are served from that domain; otherwise authority binding shows "relaxed (demo)".
UCP_NAMESPACE=

# ---- Secrets (server only; never prefix with NEXT_PUBLIC_) ---------------------------------------
SERVER_SECRET=                   # required in production; derives per-session platform API keys
MERCHANT_SIGNING_JWK=            # output of `npm run keys:generate` (private Ed25519 JWK, single line)
# ALLOW_DEMO_KEY=true            # publish the (public) demo key in production instead of a generated one

# ---- Demo behaviour -----------------------------------------------------------------------------
DEMO_MODE=live                   # live | deterministic (sequential ids, fixed clock; used by Playwright)
# DEMO_MERCHANT_ORIGINS=         # extra comma-separated https origins the platform may discover
# RELAXED_BINDING_HOSTS=localhost,vercel.app

# ---- Trip planner (Tiket AI Trips) ---------------------------------------------------------------
# A Google AI Studio key. When set, plans are written by Gemini (server side only; never NEXT_PUBLIC_). When unset, or when
# Gemini fails, the rule-based mock planner is used. On the free tier Google may use prompts to improve its products.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# TRIP_PLANNER=mock              # force the mock even when a key is set
# GEMINI_PLANS_PER_HOUR=10       # per-visitor allowance (best effort, per server instance)

# ---- Webhooks / cron ----------------------------------------------------------------------------
# Retry driver for pending webhooks (Vercel Cron sends `Authorization: Bearer $CRON_SECRET`). The route is 404 when unset.
CRON_SECRET=
# Extra comma-separated https origins webhooks may be delivered to / platform profiles fetched from:
# DEMO_PLATFORM_ORIGINS=

# ---- Conformance only (never enable in a public deployment) --------------------------------------
# ENABLE_TESTING_ENDPOINTS=false
# SIMULATION_SECRET=
